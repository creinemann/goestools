# Himawari-9 false color (relayed over GOES-West HRIT).
# Works the same way as GOES-R false color: the first channel indexes
# the LUT rows, the second the LUT columns. "vs" (band 3, 0.64 um) and
# "ir" (band 13, 10.4 um) are the Himawari equivalents of ABI ch02 and
# ch13. Band names are accepted too: [ "b03", "b13" ].
[[handler]]
type = "image"
origin = "himawari8"
channels = [ "vs", "ir" ]
directory = "./himawari9/fd/fc/{time:%Y-%m-%d}"
filename = "Himawari9_FD_FC_{time:%Y%m%dT%H%M%SZ}"
format = "jpg"
json = false

  # Himawari VS is ~2.6x darker than GOES ch02; this curve brightens
  # it and then applies the wxstar ch02 curve, so GOES-tuned LUTs fit.
  # Regenerate with scripts/make_himawari_vs_curve.py to change the gain.
  [handler.remap.vs]
  path = "${CMAKE_INSTALL_PREFIX}/share/goestools/usradioguy/himawari9_vs_curve.png"

  # Himawari IR uses a different count-to-temperature scale than GOES
  # ch13; without this, land renders red/orange instead of green.
  # Re-calibrate with scripts/calibrate_himawari_ir.py.
  [handler.remap.ir]
  path = "${CMAKE_INSTALL_PREFIX}/share/goestools/usradioguy/himawari9_ir_curve.png"

  # USRadioguy custom LUT. Swap in usradioguy_night_lut.png to keep
  # cold cloud tops visible on the night side of the disk.
  [handler.lut]
  path = "${CMAKE_INSTALL_PREFIX}/share/goestools/usradioguy/usradioguy_lut.png"

  [[handler.map]]
  path = "${CMAKE_INSTALL_PREFIX}/share/goestools/ne/ne_50m_admin_0_countries_lakes.json"

  [[handler.map]]
  path = "${CMAKE_INSTALL_PREFIX}/share/goestools/ne/ne_50m_admin_1_states_provinces_lakes.json"

# NWS text (weather reports).
[[handler]]
type = "text"
origin = "nws"
directory = "./nws/{time:%Y-%m-%d}"
filename = "{time:%Y%m%dT%H%M%SZ}_{awips:nnn}{awips:xxx}"
json = false

# NWS images.
[[handler]]
type = "image"
origin = "nws"
directory = "./nws/{time:%Y-%m-%d}"
filename = "{time:%Y%m%dT%H%M%SZ}_{filename}"
format = "png"
json = false

# Miscellaneous text.
[[handler]]
type = "text"
origin = "other"
directory = "./text/{time:%Y-%m-%d}"
filename = "{time:%Y%m%dT%H%M%SZ}_{filename}"
json = false
